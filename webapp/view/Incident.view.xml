<mvc:View
    controllerName="project1.controller.Incident"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page id="incidentPage"
          title="Incident Management"
          class="sapUiContentPadding">

        <subHeader>
            <Toolbar>
                <SearchField
                    width="100%"
                    placeholder="Search by Incident ID or Title..."
                    liveChange=".onSearch" />
            </Toolbar>
        </subHeader>

        <content>
            <Table
                id="incidentTable"
                class="incidentTableTheme"
                inset="false"
                items="{ path: '/ZGRH_EHSM_INCIDENTS' }">

                <headerToolbar>
                    <Toolbar>
                        <Title text="Reported Incidents" level="H2" />
                    </Toolbar>
                </headerToolbar>

                <columns>
                    <Column><Text text="Incident ID" /></Column>
                    <Column><Text text="Title" /></Column>
                    <Column><Text text="Status" /></Column>
                    <Column><Text text="Location" /></Column>
                    <Column><Text text="Created By" /></Column>
                    <Column><Text text="Created On" /></Column>
                </columns>

                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{IncidentId}" />
                            <Text text="{Title}" />
                            <Text text="{IncidentStatus}" />   <!-- ✅ Correct binding -->
                            <Text text="{Location}" />
                            <Text text="{CreatedBy}" />
                            <Text text="{ path: 'CreatedOn', type: 'sap.ui.model.type.Date', formatOptions: { style: 'medium' } }" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
